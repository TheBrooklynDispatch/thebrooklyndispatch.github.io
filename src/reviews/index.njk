---
layout: base.njk
title: Reviews
description: Rated film reviews from The Brooklyn Dispatch.
permalink: /reviews/
---

{% set reviews = collections.articles | sortByPublishedDate %}

<div class="wrap">

  <section class="section-intro">

    <div class="eyebrow">
      Reviews
    </div>

    <h1>
      Reviews
    </h1>

    <p>
      Rated reviews of new releases, festival films and older films worth returning to.
    </p>

  </section>

  <div class="film-grid">

    {% for article in reviews %}

      {% if article.data.stars %}

        <article class="film-card">

          {% if article.data.image %}
            <a href="{{ article.url }}" class="film-card__image-link">
              <img
                class="film-card__image"
                src="{{ article.data.image }}"
                alt="{{ article.data.title }}">
            </a>
          {% endif %}

          <div class="meta-label">
            {{ article.data.category }} · {{ article.date | readableDate }}
          </div>

          <h2>
            <a href="{{ article.url }}">
              {{ article.data.title }}
            </a>
          </h2>

          {% if article.data.dek %}
            <p>
              {{ article.data.dek }}
            </p>
          {% endif %}

          <div class="article-rating article-rating--small">
            {% if article.data.stars == 5 %}★★★★★{% endif %}
            {% if article.data.stars == 4.5 %}★★★★½{% endif %}
            {% if article.data.stars == 4 %}★★★★{% endif %}
            {% if article.data.stars == 3.5 %}★★★½{% endif %}
            {% if article.data.stars == 3 %}★★★{% endif %}
            {% if article.data.stars == 2.5 %}★★½{% endif %}
            {% if article.data.stars == 2 %}★★{% endif %}
            {% if article.data.stars == 1.5 %}★½{% endif %}
            {% if article.data.stars == 1 %}★{% endif %}
            <span class="article-rating__out-of">{{ article.data.stars }}/5</span>
          </div>

          <a class="text-link" href="{{ article.url }}">
            Read →
          </a>

        </article>

      {% endif %}

    {% endfor %}

  </div>

</div>