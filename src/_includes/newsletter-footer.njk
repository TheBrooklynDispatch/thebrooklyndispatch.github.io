<div class="footer-newsletter">

  <div class="footer-label">
    Newsletter
  </div>

  <p class="footer-newsletter__title">
    The Brooklyn Dispatch, in your inbox.
  </p>

  <form
    action="https://buttondown.com/api/emails/embed-subscribe/TheBrooklynDispatch"
    method="post"
    class="footer-newsletter__form"
  >

    <label class="sr-only" for="footer-newsletter-email">
      Email address
    </label>

    <input
      id="footer-newsletter-email"
      type="email"
      name="email"
      placeholder="Your email"
      required
    >

    <input
      type="hidden"
      name="embed"
      value="1"
    >

    <button type="submit">
      Subscribe →
    </button>

  </form>

</div>