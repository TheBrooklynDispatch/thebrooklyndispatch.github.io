---
layout: base.njk
title: On the Shelf
description: Monthly recommendations from The Brooklyn Dispatch.
permalink: /shelf/
eleventyExcludeFromCollections: true
---

{% set latest = collections.shelf | reverse | first %}

{% if latest %}

  {{ latest.templateContent | safe }}

  <section class="archive-section wrap">

    <div class="section-heading">
      <h2>Archive</h2>
    </div>

    <div class="archive-list">

      {% for item in collections.shelf | reverse %}

        <a class="archive-row" href="{{ item.url }}">
          <span>{{ item.data.month }} {{ item.data.year }}</span>
          <span>→</span>
        </a>

      {% endfor %}

    </div>

  </section>

{% else %}

  <section class="section-intro wrap">

    <h1>On the Shelf</h1>

    <p>
      No Shelf editions have been published yet.
    </p>

  </section>

{% endif %}