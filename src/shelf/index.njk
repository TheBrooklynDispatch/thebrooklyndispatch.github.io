---
layout: base.njk
title: Shelf
description: Monthly selections from The Brooklyn Dispatch.
---

<section class="wrap">

  {% set latest = collections.shelf | reverse | first %}

  {{ latest.templateContent | safe }}

</section>

<section class="archive-section wrap">

  <div class="section-heading">
    <h2>Archive</h2>
  </div>

  <div class="archive-list">

    {% for item in collections.shelf | reverse %}

      <a
        class="archive-row"
        href="{{ item.url }}"
      >
        <span>{{ item.data.month }} {{ item.data.year }}</span>
        <span>→</span>
      </a>

    {% endfor %}

  </div>

</section>