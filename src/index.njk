---
layout: base.njk
description: Film, books and the places they lead.
---
{% set feature = collections.featured[0] %}
<section class="home-hero wrap">
  <div class="home-hero__copy">
    <div class="eyebrow">Featured</div>
    {% if feature %}
      <h1><a href="{{ feature.url }}">{{ feature.data.title }}</a></h1>
      <p>{{ feature.data.dek }}</p>
      <a class="text-link" href="{{ feature.url }}">Read {{ feature.data.format | lower }} →</a>
    {% else %}
      <h1>Culture worth spending time with.</h1>
      <p>Reviews, essays and dispatches that leave you with somewhere to go next.</p>
    {% endif %}
  </div>
  <div class="hero-poster" aria-hidden="true">
    <div class="hero-poster__line"></div>
  </div>
</section>

<section class="home-section wrap">
  <div class="section-heading">
    <h2>Latest Dispatches</h2>
    <p>Recent writing from across the publication.</p>
  </div>
  <div class="story-grid">
    {% for article in collections.articles | limit(3) %}
    <article class="story-card">
      <div class="meta-label">{{ article.data.section }}</div>
      <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
      <p>{{ article.data.dek }}</p>
      <span class="story-date">{{ article.date | readableDate }}</span>
    </article>
    {% endfor %}
  </div>
</section>

<section class="home-section wrap">
  <div class="section-heading">
    <h2>Collections</h2>
    <p>Ideas worth following across film, books and beyond.</p>
  </div>
  <div class="collection-grid">
    <a class="collection-card" href="#">
      <span class="meta-label">Collection</span>
      <strong>Memory</strong>
      <span>Films, books and essays about what we keep.</span>
    </a>
    <a class="collection-card" href="#">
      <span class="meta-label">Collection</span>
      <strong>Physical Media</strong>
      <span>On records, books, ownership and ritual.</span>
    </a>
    <a class="collection-card" href="#">
      <span class="meta-label">Collection</span>
      <strong>Cities on Film</strong>
      <span>Places that become characters.</span>
    </a>
  </div>
</section>

<section class="home-section wrap">
  <div class="section-heading">
    <h2>The Shelf</h2>
    <p>Four things worth spending time with right now.</p>
  </div>
  <div class="shelf-grid">
    <div class="shelf-item"><span class="meta-label">Film</span><strong>Still Walking</strong><span>Hirokazu Kore-eda, 2008</span></div>
    <div class="shelf-item"><span class="meta-label">Book</span><strong>The Rings of Saturn</strong><span>W. G. Sebald</span></div>
    <div class="shelf-item"><span class="meta-label">Album</span><strong>Blue</strong><span>Joni Mitchell</span></div>
    <div class="shelf-item"><span class="meta-label">Place</span><strong>Metrograph</strong><span>New York</span></div>
  </div>
  <a class="text-link shelf-link" href="/shelf/">View the Shelf →</a>
</section>
