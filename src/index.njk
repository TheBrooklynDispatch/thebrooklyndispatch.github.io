---
layout: base.njk
title: The Brooklyn Dispatch
description: Essays and recommendations on films, books, music and the places they lead.
permalink: /
---


{% set latestShelf = collections.shelf | reverse | first %}
{% set writing = collections.articles | sortByPublishedDate %}
{% set featured = writing | first %}

<div class="wrap">


{% if featured %}

<div class="eyebrow home-latest-label">
  Latest
</div>

<article class="home-feature">

  {% if featured.data.image %}
    <a href="{{ featured.url }}">
      <img
        class="home-feature__image"
        src="{{ featured.data.image }}"
        alt="{{ featured.data.title }}">
    </a>
  {% endif %}

  {% if featured.data.category %}
    <div class="meta-label">
      {{ featured.data.category }} · {{ featured.date | readableDate }}
    </div>
  {% endif %}

  <h1>
    <a href="{{ featured.url }}">
      {{ featured.data.title }}
    </a>
  </h1>

  {% if featured.data.dek %}
    <p>
      {{ featured.data.dek }}
    </p>
  {% endif %}

  {% if featured.data.stars %}
    <div class="article-rating">
      {% if featured.data.stars == 5 %}★★★★★{% endif %}
      {% if featured.data.stars == 4.5 %}★★★★½{% endif %}
      {% if featured.data.stars == 4 %}★★★★{% endif %}
      {% if featured.data.stars == 3.5 %}★★★½{% endif %}
      {% if featured.data.stars == 3 %}★★★{% endif %}
      {% if featured.data.stars == 2.5 %}★★½{% endif %}
      {% if featured.data.stars == 2 %}★★{% endif %}
      {% if featured.data.stars == 1.5 %}★½{% endif %}
      {% if featured.data.stars == 1 %}★{% endif %}
      <span class="article-rating__out-of">{{ featured.data.stars }}/5</span>
    </div>
  {% endif %}

  <a class="text-link" href="{{ featured.url }}">
    Read →
  </a>

</article>

{% endif %}


{% if writing | length > 1 %}

<div class="section-heading">

  <div>

    <div class="eyebrow">
      Recent Writing
    </div>

    <h2>
      More from the Dispatch
    </h2>

  </div>

</div>

<div class="home-writing-grid">

  {% for article in writing %}

    {% if loop.index > 1 and loop.index <= 3 %}

      <article class="home-writing-card">

        <a href="{{ article.url }}">

          {% if article.data.image %}
            <img
              class="home-writing-card__image"
              src="{{ article.data.image }}"
              alt="{{ article.data.title }}">
          {% endif %}

        </a>

        {% if article.data.category %}
          <div class="meta-label">
            {{ article.data.category }} · {{ article.date | readableDate }}
          </div>
        {% endif %}

        <h3>
          <a href="{{ article.url }}">
            {{ article.data.title }}
          </a>
        </h3>

        {% if article.data.dek %}
          <p>
            {{ article.data.dek }}
          </p>
        {% endif %}

        {% if article.data.stars %}
          <div class="article-rating article-rating--small">
            {% if article.data.stars == 5 %}★★★★★{% endif %}
            {% if article.data.stars == 4.5 %}★★★★½{% endif %}
            {% if article.data.stars == 4 %}★★★★{% endif %}
            {% if article.data.stars == 3.5 %}★★★½{% endif %}
            {% if article.data.stars == 3 %}★★★{% endif %}
            {% if article.data.stars == 2.5 %}★★½{% endif %}
            {% if article.data.stars == 2 %}★★{% endif %}
            {% if article.data.stars == 1.5 %}★½{% endif %}
            {% if article.data.stars == 1 %}★{% endif %}
            <span class="article-rating__out-of">{{ article.data.stars }}/5</span>
          </div>
        {% endif %}

        <a class="text-link" href="{{ article.url }}">
          Read →
        </a>

      </article>

    {% endif %}

  {% endfor %}

</div>

{% endif %}


{% if writing | length > 3 %}

<div class="home-writing-grid home-writing-grid--three">

  {% for article in writing %}

    {% if loop.index > 3 and loop.index <= 6 %}

      <article class="home-writing-card home-writing-card--compact">

        <a href="{{ article.url }}">

          {% if article.data.image %}
            <img
              class="home-writing-card__image"
              src="{{ article.data.image }}"
              alt="{{ article.data.title }}">
          {% endif %}

        </a>

        {% if article.data.category %}
          <div class="meta-label">
            {{ article.data.category }} · {{ article.date | readableDate }}
          </div>
        {% endif %}

        <h3>
          <a href="{{ article.url }}">
            {{ article.data.title }}
          </a>
        </h3>

        {% if article.data.dek %}
          <p>
            {{ article.data.dek }}
          </p>
        {% endif %}

        {% if article.data.stars %}
          <div class="article-rating article-rating--small">
            {% if article.data.stars == 5 %}★★★★★{% endif %}
            {% if article.data.stars == 4.5 %}★★★★½{% endif %}
            {% if article.data.stars == 4 %}★★★★{% endif %}
            {% if article.data.stars == 3.5 %}★★★½{% endif %}
            {% if article.data.stars == 3 %}★★★{% endif %}
            {% if article.data.stars == 2.5 %}★★½{% endif %}
            {% if article.data.stars == 2 %}★★{% endif %}
            {% if article.data.stars == 1.5 %}★½{% endif %}
            {% if article.data.stars == 1 %}★{% endif %}
            <span class="article-rating__out-of">{{ article.data.stars }}/5</span>
          </div>
        {% endif %}

        <a class="text-link" href="{{ article.url }}">
          Read →
        </a>

      </article>

    {% endif %}

  {% endfor %}

</div>

{% endif %}


{% if latestShelf %}

<div class="section-heading">

  <div>

    <div class="eyebrow">
      The Shelf
    </div>

    <h2>
      {{ latestShelf.data.month }} {{ latestShelf.data.year }}
    </h2>

  </div>

  <a class="text-link" href="{{ latestShelf.url }}">
    One film. One book. One album. One venue. View the Shelf →
  </a>

</div>

<div class="home-shelf-grid">

  {% for pick in latestShelf.data.picks %}

    <a class="home-shelf-card" href="{{ latestShelf.url }}">

      <img
        src="{{ pick.image }}"
        alt="{{ pick.alt }}"
        class="home-shelf-card__image">

      <span class="meta-label">
        {{ pick.category }}
      </span>

      <h3>

        {% if pick.category != "Place" %}
          <em>{{ pick.title }}</em>
        {% else %}
          {{ pick.title }}
        {% endif %}

        {% if pick.year %}
          <span class="home-shelf-year">
            ({{ pick.year }})
          </span>
        {% endif %}

      </h3>

      <span class="home-shelf-card__creator">
        {{ pick.creator }}
      </span>

    </a>

  {% endfor %}

</div>

{% endif %}

{% include "newsletter.njk" %}

</div>
```
